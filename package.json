{
  "name": "agent-mobile-emulators",
  "productName": "Enxame",
  "version": "0.1.0",
  "private": true,
  "description": "Cockpit para um enxame de emuladores Android dirigidos por agentes",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start": "electron .",
    "typecheck": "tsc -b --noEmit",
    "daemon:build": "tsc -p tsconfig.daemon.json",
    "daemon:start": "node --env-file-if-exists=.env dist-daemon/index.js",
    "test": "vitest run",
    "test:integration": "cross-env ENXAME_INTEGRATION=1 vitest run --project daemon",
    "real:run": "npm run daemon:build && node --env-file-if-exists=.env dist-daemon/cli/run-real.js",
    "bench": "npm run daemon:build && node --env-file-if-exists=.env dist-daemon/cli/bench.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/mcp": "^2.0.60",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@napi-rs/keyring": "^2.1.0",
    "ai": "^7.0.116",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "^33.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.2",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
