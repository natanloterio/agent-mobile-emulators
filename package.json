{
  "name": "tapflock",
  "productName": "Tapflock",
  "version": "0.1.0",
  "description": "Tapflock: cockpit para um enxame de emuladores Android dirigidos por agentes",
  "license": "AGPL-3.0-only",
  "author": "Natan Loterio <natan@gaiahub.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/natanloterio/tapflock.git"
  },
  "homepage": "https://github.com/natanloterio/tapflock",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "start": "electron .",
    "typecheck": "tsc -b --noEmit",
    "daemon:build": "tsc -p tsconfig.daemon.json",
    "daemon:start": "node --env-file-if-exists=.env dist-daemon/index.js",
    "test": "vitest run",
    "test:integration": "cross-env TAPFLOCK_INTEGRATION=1 vitest run --project daemon",
    "real:run": "npm run daemon:build && node --env-file-if-exists=.env dist-daemon/cli/run-real.js",
    "bench": "npm run daemon:build && node --env-file-if-exists=.env dist-daemon/cli/bench.js",
    "dist:linux": "npm run build && npm run daemon:build && electron-builder --linux --x64 --publish never",
    "dist:mac": "npm run build && npm run daemon:build && electron-builder --mac --publish never",
    "dist:win": "npm run build && npm run daemon:build && electron-builder --win --x64 --publish never",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/mcp": "^2.0.60",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@napi-rs/keyring": "^2.1.0",
    "ai": "^7.0.116",
    "extract-zip": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "playwright": "1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.2",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "build": {
    "appId": "me.pitaia.tapflock",
    "productName": "Tapflock",
    "copyright": "Copyright (C) 2026 Natan Loterio",
    "directories": { "output": "release", "buildResources": "build" },
    "icon": "build/icon.png",
    "files": ["dist/**", "dist-electron/**", "dist-daemon/**", "daemon/vendor/**", "package.json", "!**/*.test.*", "!**/*.map"],
    "asarUnpack": ["daemon/vendor/**"],
    "extraFiles": [{ "from": "LICENSE", "to": "LICENSE" }, { "from": "NOTICE", "to": "NOTICE" }],
    "npmRebuild": false,
    "afterPack": "scripts/adhoc-sign.cjs",
    "linux": { "target": ["AppImage", "deb"], "icon": "build/icon.png", "category": "Development", "maintainer": "Natan Loterio <natan@gaiahub.ai>", "executableName": "tapflock" },
    "deb": { "packageName": "tapflock", "artifactName": "tapflock_${version}_${arch}.${ext}", "fpm": ["--replaces=enxame", "--conflicts=enxame"] },
    "mac": { "target": ["dmg"], "icon": "build/icon-mac.png", "category": "public.app-category.developer-tools", "identity": null, "hardenedRuntime": false },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true }
  }
}
